% gnu Octave code for plotting explosive lens geometry

pkg install -forge matgeom;
pkg load matgeom;

HEX_ANGLE =  asin(4 / sqrt(58 + (18 * sqrt(5))));
PENT_ANGLE = asin((2 * sqrt(50 + (10 * sqrt(5)))) / (5 * sqrt(58 + (18 * sqrt(5)))));

N = 4900*1000;
M = 8050*1000;

LENS_OUTER_RADIUS = 688.975;
LENS_HEIGHT = 224.425;
LENS_INNER_RADIUS = (LENS_OUTER_RADIUS - LENS_HEIGHT);

function drawPrism(apicalAngle, LENS_INNER_RADIUS, LENS_OUTER_RADIUS)
    x1 = LENS_OUTER_RADIUS * sin(apicalAngle);
    y1 = LENS_OUTER_RADIUS * cos(apicalAngle);
    x2 = LENS_INNER_RADIUS * sin(apicalAngle);
    y2 = LENS_INNER_RADIUS * cos(apicalAngle);
    plot([x1, x2], [y1, y2], 'b-', 'LineWidth', 2);
    plot([-x1, -x2], [y1, y2], 'b-', 'LineWidth', 2);

    theta1 = rad2deg(atan2(y1, x1));
    theta2 = rad2deg(atan2(y1, -x1));
    extent = theta2 - theta1;

    outerArc = [0, 0, LENS_OUTER_RADIUS, theta1, extent];
    drawCircleArc(outerArc, 'b-', 'LineWidth', 2);
    innerArc = [0, 0, LENS_INNER_RADIUS, theta1, extent];
    drawCircleArc(innerArc, 'b-', 'LineWidth', 2);
endfunction

# Equation A: cartesian [Richard]
function k = eqaCart(x, y)
    k = ((N * (np.sqrt(x^2 + y^2) - R_a)) + 
         (M * (np.sqrt(x^2 + (R_l - y)^2))))
endfunction

figure;
axis([-300 300 0 700]);
hold on;

drawPrism(HEX_ANGLE, LENS_INNER_RADIUS, LENS_OUTER_RADIUS);



axis equal;
xlim([-300, 300])
ylim([0, 700])
xlabel("X-axis");
ylabel("Y-axis");

grid on;



#f = @(y) M*sqrt(x^2+(y-LENS_OUTER_DIAMETER)^2) + N*sqrt(x^2+y^2) - LENS_OUTER_DIAMETER*(M*r + N*(1-r));
#y = fzero(f, LENS_OUTER_DIAMETER-100);

function y = findY(x, r, M, N, Rl, initialValue)
    % Define the equation as a function of y
    f = @(y) M*sqrt(x^2+(y-Rl)^2) + N*sqrt(x^2+y^2) - Rl*(M*r + N*(1-r));
    
    % Use fzero to find the root (y value that satisfies the equation)
    y = fzero(f, initialValue);  % Using 0 as an initial guess
end

R = linspace(0.0, 1.0, 100);

% Initialize an array to store the results
Y = zeros(size(R));

for i = 1:length(R)
    Y(i) = findY(x, R(i), m, N, Rl, n);
end

plot(R, Y, 'b-o', 'LineWidth', 2);
